{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user data including MFA settings and trusted devices.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "mfa": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "methods": { "type": "array", "items": { "type": "string" } },
            "primaryMethod": { "type": "string" },
            "totpSecret": { "type": "string", "description": "Encrypted or hashed TOTP secret" },
            "emailOtp": {
              "type": "object",
              "properties": {
                "code": { "type": "string" },
                "expiresAt": { "type": "string", "format": "date-time" }
              }
            },
            "backupCodes": { "type": "array", "items": { "type": "string" }, "description": "Hashed backup codes" }
          }
        },
        "trustedDevices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "deviceId": { "type": "string" },
              "deviceName": { "type": "string" },
              "location": { "type": "string" },
              "lastUsed": { "type": "string", "format": "date-time" },
              "expiresAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "lastMfaChallenge": { "type": "string", "format": "date-time" },
        "failedAttempts": { "type": "number" },
        "lockoutUntil": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User documents containing MFA and security metadata."
    }
  }
}
