{
  "entities": {
    "CognitiveDocument": {
      "title": "Cognitive Document",
      "description": "A document uploaded for analysis and context.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the owner." },
        "name": { "type": "string", "description": "File name." },
        "content": { "type": "string", "description": "Extracted text content." },
        "type": { "type": "string", "description": "MIME type or file extension." },
        "timestamp": { "type": "object", "description": "Creation timestamp." },
        "updatedAt": { "type": "object", "description": "Last update timestamp." }
      },
      "required": ["userId", "name", "content", "type", "timestamp"]
    },
    "SimulationHistory": {
      "title": "Simulation History",
      "description": "Recorded history of a simulation session.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["avatar", "avatar2", "staged"] },
        "timestamp": { "type": "object" },
        "meetingContext": { "type": "object" },
        "messages": { "type": "array", "items": { "type": "object" } },
        "report": { "type": "object" },
        "biometrics": { "type": "object" },
        "score": { "type": "number" }
      },
      "required": ["userId", "type", "timestamp", "meetingContext", "messages"]
    },
    "MeetingContext": {
      "title": "Meeting Context",
      "description": "Configuration for a specific meeting simulation.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "meetingContext": { "type": "object" },
        "selectedLibraryDocIds": { "type": "array", "items": { "type": "string" } },
        "analysis": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["userId", "meetingContext", "selectedLibraryDocIds", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/cognitive_documents/{docId}": {
      "schema": "CognitiveDocument",
      "description": "User-specific documents."
    },
    "/users/{userId}/simulation_history/{historyId}": {
      "schema": "SimulationHistory",
      "description": "User-specific simulation history."
    },
    "/users/{userId}/meeting_contexts/{contextId}": {
      "schema": "MeetingContext",
      "description": "User-specific meeting configurations."
    }
  }
}
