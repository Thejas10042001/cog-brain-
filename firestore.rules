
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Enforce that each user can only access their own subcollections under /users/{userId}
    match /users/{userId}/{subcollection}/{document} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Legacy rules for top-level collections (if any data remains there)
    match /cognitive_documents/{document} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    match /meeting_contexts/{document} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    match /simulation_history/{document} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
