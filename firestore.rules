rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidFolder(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 255 &&
             (data.parentId == null || data.parentId is string) &&
             data.createdAt is string &&
             (!('isDefault' in data) || data.isDefault is bool);
    }

    function isValidDocument(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 255 &&
             data.fileUrl is string &&
             (data.folderId == null || data.folderId is string) &&
             data.uploadedAt is string &&
             (!('content' in data) || data.content is string) &&
             (!('metadata' in data) || data.metadata is map);
    }

    // ===============================================================
    // Match Rules
    // ===============================================================
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /folders/{folderId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFolder(request.resource.data);
        allow update: if isOwner(userId) && isValidFolder(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /documents/{documentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDocument(request.resource.data);
        allow update: if isOwner(userId) && isValidDocument(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }
  }
}
